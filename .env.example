KA_ENV=development
KA_DEV_AUTH=true
KA_DATABASE_URL=postgresql+psycopg://knowledge_app:local-runtime-only@127.0.0.1:55432/knowledge
KA_MIGRATION_URL=postgresql+psycopg://knowledge_owner:local-owner-only@127.0.0.1:55432/knowledge
KA_ORIGIN=http://127.0.0.1:5173
KA_STORAGE_DIR=../.data/objects
KA_GENERATION_MODE=evidence
KA_GENERATION_ENABLED=true
# Live mode requires an explicit model, API key, and conservative reservation amount.
# KA_GENERATION_MODE=anthropic
# KA_MODEL=claude-haiku-4-5-20251001
# KA_ANTHROPIC_API_KEY=
# KA_OIDC_DISCOVERY_URL=
# KA_OIDC_CLIENT_ID=
# KA_OIDC_CLIENT_SECRET=
# Optional local embeddings require: uv sync --extra semantic
KA_SEMANTIC_SEARCH=false
